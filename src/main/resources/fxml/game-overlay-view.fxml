<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.controllers.game.GameOverlayController">
   <children>
      <HBox AnchorPane.topAnchor="0.0">
         <children>
            <VBox fx:id="scoresVbox" alignment="TOP_CENTER">
               <children>
                  <Label text="Scores" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <Region prefHeight="200.0" prefWidth="200.0" />
            <Label text="Label" />
            <Region />
         </children>
      </HBox>
      <HBox prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0">
         <children>
            <fx:include fx:id="chatPane" source="chat-view.fxml" />
            <ImageView fx:id="commonGoal1" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="commonGoal2" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fx:id="personalGoal" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </HBox>
   </children>
</AnchorPane>
