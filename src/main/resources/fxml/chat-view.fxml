<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" fx:id="chat" cache="true" cacheHint="SPEED"
           stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19"
           fx:controller="it.polimi.myshelfie.view.graphical.controllers.ChatController">
    <ImageView fx:id="backgroundImage" onMousePressed="#toggleChat" pickOnBounds="true">
        <Image url="@../images/darkWood.jpg"/>
    </ImageView>
    <Label fx:id="notificationDot" cache="true" alignment="CENTER" cacheHint="SCALE" layoutX="70.0" layoutY="4.0"
           maxHeight="30.0" maxWidth="30.0" minHeight="30.0" minWidth="30.0" prefHeight="30.0" prefWidth="30.0"
           style="-fx-background-color: AntiqueWhite; -fx-background-radius: 100; -fx-font-size: 15;" text="0"
           textAlignment="CENTER" visible="false" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets left="20.0" top="20.0"/>
        </StackPane.margin>
    </Label>
    <VBox alignment="CENTER">
        <Label alignment="CENTER" onMousePressed="#toggleChat" maxHeight="60.0" minHeight="60.0" prefHeight="60.0"
               text="CHAT" textFill="#faebd2" VBox.vgrow="NEVER">
            <padding>
                <Insets bottom="5.0" left="20.0" right="20.0" top="5.0"/>
            </padding>
        </Label>
        <StackPane VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <ImageView fx:id="messagesBackgroundImage" pickOnBounds="true" StackPane.alignment="CENTER">
                <Image url="@../images/lightWood.jpg"/>
            </ImageView>
            <ScrollPane fx:id="chatScroll" hbarPolicy="NEVER" vbarPolicy="NEVER" StackPane.alignment="CENTER">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </padding>
                <VBox fx:id="messagesVBox" spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" top="10.0"/>
                    </padding>
                </VBox>
            </ScrollPane>
        </StackPane>
        <HBox alignment="CENTER" maxHeight="80.0" minHeight="80.0" prefHeight="80.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <ChoiceBox fx:id="receiverChoice" maxHeight="60.0" maxWidth="100.0" minHeight="60.0"
                       minWidth="100.0" prefHeight="60.0" prefWidth="100.0" HBox.hgrow="NEVER"/>
            <TextField fx:id="messageText" maxHeight="60.0" minHeight="60.0" prefHeight="60.0" prefWidth="300.0"
                       style="-fx-font-size: 25;" HBox.hgrow="ALWAYS"/>
            <Button maxHeight="60.0" maxWidth="60.0" minHeight="60.0" minWidth="60.0" mnemonicParsing="false"
                    onMousePressed="#sendMessage" prefHeight="60.0" prefWidth="60.0" text="&gt;"/>
        </HBox>
    </VBox>
</StackPane>
