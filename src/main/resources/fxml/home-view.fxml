<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" cache="true" cacheHint="SPEED" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/19"
           fx:controller="it.polimi.myshelfie.view.graphical.controllers.pregame.HomeController">
    <ImageView fx:id="clearBackground" cache="true" cacheHint="SPEED" pickOnBounds="true">
        <Image url="@../images/lightWood.jpg"/>
    </ImageView>
    <VBox alignment="CENTER" cache="true" cacheHint="SPEED" spacing="10.0">
        <Button fx:id="joinButton" cache="true" cacheHint="SPEED" mnemonicParsing="false"
                onMouseClicked="#onJoinChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton" text="Join"
                VBox.vgrow="ALWAYS">
        </Button>
        <Button fx:id="createButton" cache="true" cacheHint="SPEED" mnemonicParsing="false"
                onMouseClicked="#onCreateChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton"
                text="Create" VBox.vgrow="ALWAYS">
        </Button>
    </VBox>
</StackPane>
