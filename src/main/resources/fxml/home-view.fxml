<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.controllers.HomeController">
   <children>
      <ImageView fx:id="clearBackground" cache="true" cacheHint="SPEED" pickOnBounds="true">
         <image>
            <Image url="@../images/lightWood.jpg" />
         </image>
      </ImageView>
      <VBox fx:id="buttonsVBox" alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="joinButton" mnemonicParsing="false" onMouseClicked="#onJoinChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton" text="Join" VBox.vgrow="ALWAYS">
      </Button>
            <Button fx:id="createButton" mnemonicParsing="false" onMouseClicked="#onCreateChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton" text="Create" VBox.vgrow="ALWAYS">
      </Button>
         </children>
      </VBox>
   </children>
</StackPane>
