<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.controllers.HomeController">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <Image url="@../images/background.png" />
      </ImageView>
      <ProgressIndicator fx:id="progress" layoutX="112.0" layoutY="582.0" visible="false" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
      <Button layoutX="325.0" layoutY="335.0" mnemonicParsing="false" onMouseClicked="#onCreateChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton" text="Create">
      </Button>
      <Button layoutX="325.0" layoutY="491.0" mnemonicParsing="false" onMouseClicked="#onJoinChoice" prefHeight="100.0" prefWidth="630.0" styleClass="myButton" text="Join">
      </Button>
   </children>
</AnchorPane>
