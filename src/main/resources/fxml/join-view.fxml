<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1" cache="true" cacheHint="SPEED" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/19"
           fx:controller="it.polimi.myshelfie.view.graphical.controllers.pregame.JoinController">
    <ImageView fx:id="clearBackground" pickOnBounds="true">
        <Image url="@../images/lightWood.jpg"/>
    </ImageView>
    <VBox StackPane.alignment="CENTER">
        <padding>
            <Insets top="30.0"/>
        </padding>
        <StackPane VBox.vgrow="ALWAYS">
            <ImageView fx:id="listBackgroundImage" pickOnBounds="true" StackPane.alignment="CENTER">
                <Image url="@../images/darkWood.jpg"/>
            </ImageView>
            <ScrollPane fx:id="lobbiesScrollPane" hbarPolicy="NEVER" hmax="0.0" stylesheets="@../css/style.css"
                        StackPane.alignment="CENTER">
                <HBox>
                    <VBox fx:id="lobbiesVBox"/>
                </HBox>
            </ScrollPane>
        </StackPane>
        <HBox alignment="CENTER" spacing="20.0">
            <TextField fx:id="playerNameField" alignment="CENTER" cache="true" cacheHint="SCALE" maxHeight="70.0"
                       maxWidth="300.0" minHeight="70.0" minWidth="300.0" prefHeight="70.0" prefWidth="300.0"
                       promptText="Player name">
                <HBox.margin>
                    <Insets/>
                </HBox.margin>
            </TextField>
            <Button fx:id="joinButton" cache="true" cacheHint="SCALE" disable="true" maxHeight="70.0"
                    maxWidth="300.0" minHeight="70.0" minWidth="300.0" mnemonicParsing="false"
                    onMouseClicked="#onJoinMouseClicked" prefHeight="70.0" prefWidth="300.0"
                    style="-fx-font-size: 30;" styleClass="myButton" text="Join">
                <HBox.margin>
                    <Insets bottom="20.0" top="20.0"/>
                </HBox.margin>
            </Button>
        </HBox>
    </VBox>
    <Label fx:id="joinErrorLabel" alignment="CENTER" cache="true" prefHeight="70.0" styleClass="error" text="error"
           visible="false" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="20.0" right="20.0"/>
        </StackPane.margin>
    </Label>
</StackPane>
