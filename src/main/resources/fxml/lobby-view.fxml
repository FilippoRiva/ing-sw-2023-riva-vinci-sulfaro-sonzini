<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<AnchorPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.controllers.LobbyController">
    <children>
        <ImageView fitHeight="720.0" fitWidth="1280.0" layoutX="-7.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../images/background.png" />
        </ImageView>
      <ProgressIndicator fx:id="progress" visible="false" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
      <StackPane layoutX="30.0" layoutY="296.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0">
         <children>
            <ImageView fitHeight="420.0" fitWidth="840.0" pickOnBounds="true">
               <image>
                  <Image url="@../images/darkWood.jpg" />
               </image>
            </ImageView>
            <ScrollPane hbarPolicy="NEVER" hmax="0.0" maxHeight="350.0" prefHeight="350.0" prefWidth="840.0" stylesheets="@../css/style.css" StackPane.alignment="BOTTOM_CENTER">
               <content>
                  <VBox fx:id="playersVBox" alignment="CENTER" maxWidth="838.0" prefWidth="838.0" />
               </content>
            </ScrollPane>
            <AnchorPane maxHeight="70.0" prefHeight="70.0" prefWidth="840.0" StackPane.alignment="TOP_CENTER">
               <children>
                   <Label fx:id="lobbyNameLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="138.0"
                          layoutY="14.0" prefHeight="64.0" prefWidth="449.0" style="-fx-font-size: 35;"
                          text="Lobby name" textAlignment="CENTER" textFill="#f2ebeb" AnchorPane.leftAnchor="138.0"
                          AnchorPane.topAnchor="14.0"/>
                   <Label fx:id="playersInLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="692.0"
                          layoutY="7.0" style="-fx-font-size: 35;" text="1/4" textAlignment="CENTER" textFill="WHITE"
                          AnchorPane.rightAnchor="94.39999999999998" AnchorPane.topAnchor="7.0"/>
                   <Button fx:id="minusButton" alignment="CENTER" disable="true" layoutX="617.0" layoutY="26.0"
                           maxHeight="50.0" maxWidth="50.0" minHeight="40.0" minWidth="44.0"
                           onMouseClicked="#onMouseMinusClicked" prefHeight="40.0" prefWidth="44.0"
                           stylesheets="@../css/style.css" text="-" textAlignment="CENTER" textFill="WHITE"
                           AnchorPane.rightAnchor="179.0" AnchorPane.topAnchor="26.0"/>
                   <Button fx:id="plusButton" alignment="CENTER" disable="true" layoutX="777.0" layoutY="26.0"
                           maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0"
                           onMouseClicked="#onMousePlusClicked" prefHeight="40.0" prefWidth="40.0"
                           stylesheets="@../css/style.css" text="+" textAlignment="CENTER" textFill="WHITE"
                           wrapText="true" AnchorPane.rightAnchor="23.0" AnchorPane.topAnchor="26.0"/>
               </children>
            </AnchorPane>
         </children>
      </StackPane>
      <Button fx:id="startButton" disable="true" layoutX="932.0" layoutY="360.0" mnemonicParsing="false" onMouseClicked="#onStartMouseClicked" prefHeight="90.0" prefWidth="288.0" styleClass="myButton" text="Start" />
        <Label fx:id="errorLabel" alignment="CENTER_RIGHT" layoutX="1042.0" layoutY="318.0" prefHeight="53.0"
               prefWidth="294.0" styleClass="error" text="error" textFill="RED" visible="false"
               AnchorPane.bottomAnchor="165.0" AnchorPane.rightAnchor="50.0"/>
      <Button layoutX="39.0" layoutY="38.0" mnemonicParsing="false" onMouseClicked="#onBackArrowClick" prefHeight="77.0" prefWidth="81.0" styleClass="arrow" />
    </children>
</AnchorPane>
