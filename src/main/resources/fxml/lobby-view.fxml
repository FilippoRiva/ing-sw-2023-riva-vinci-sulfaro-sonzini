<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.controllers.LobbyController">
    <children>
        <ImageView fitHeight="720.0" fitWidth="1280.0" layoutX="-7.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../images/background.png" />
        </ImageView>
      <ProgressIndicator fx:id="progress" visible="false" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
      <StackPane layoutX="30.0" layoutY="296.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0">
         <children>
            <ImageView fitHeight="420.0" fitWidth="840.0" pickOnBounds="true">
               <image>
                  <Image url="@../images/darkWood.jpg" />
               </image>
            </ImageView>
            <ScrollPane hbarPolicy="NEVER" hmax="0.0" maxHeight="350.0" prefHeight="350.0" prefWidth="840.0" stylesheets="@../css/style.css" StackPane.alignment="BOTTOM_CENTER">
               <content>
                  <VBox fx:id="playersVBox" alignment="CENTER" maxWidth="838.0" prefWidth="838.0" />
               </content>
            </ScrollPane>
            <AnchorPane maxHeight="70.0" prefHeight="70.0" prefWidth="840.0" StackPane.alignment="TOP_CENTER">
               <children>
                  <Label fx:id="lobbyNameLabel" contentDisplay="CENTER" text="Lobby name" textAlignment="CENTER" textFill="#f2ebeb" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="0.0">
                     <font>
                        <Font name="Kristen ITC" size="40.0" />
                     </font>
                  </Label>
                  <Label fx:id="playersInLabel" alignment="CENTER" contentDisplay="CENTER" text="1/4" textAlignment="CENTER" textFill="WHITE" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="0.0">
                     <font>
                        <Font name="Kristen ITC" size="40.0" />
                     </font>
                  </Label>
                  <Button fx:id="minusButton" alignment="CENTER" disable="true" layoutX="690.0" layoutY="15.0" maxHeight="50.0" maxWidth="50.0" minHeight="40.0" minWidth="44.0" onMouseClicked="#onMouseMinusClicked" prefHeight="40.0" prefWidth="44.0" stylesheets="@../css/style.css" text="-" textAlignment="CENTER" textFill="WHITE" AnchorPane.rightAnchor="180.0" AnchorPane.topAnchor="15.0">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Button>
                  <Button fx:id="plusButton" alignment="CENTER" disable="true" layoutX="779.0" layoutY="30.0" maxHeight="40.0" maxWidth="40.0" minHeight="40.0" minWidth="40.0" onMouseClicked="#onMousePlusClicked" prefHeight="40.0" prefWidth="40.0" stylesheets="@../css/style.css" text="+" textAlignment="CENTER" textFill="WHITE" wrapText="true" AnchorPane.rightAnchor="21.0" AnchorPane.topAnchor="30.0">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Button>
               </children>
            </AnchorPane>
         </children>
      </StackPane>
      <Button fx:id="startButton" disable="true" layoutX="932.0" layoutY="360.0" mnemonicParsing="false" onMouseClicked="#onStartMouseClicked" prefHeight="90.0" prefWidth="288.0" styleClass="myButton" text="Start" />
      <Label fx:id="errorLabel" alignment="CENTER_RIGHT" layoutX="1042.0" layoutY="318.0" text="error" textFill="RED" visible="false" AnchorPane.bottomAnchor="200.0" AnchorPane.rightAnchor="50.0">
         <font>
            <Font size="20.0" />
         </font>
      </Label>
      <Button layoutX="39.0" layoutY="38.0" mnemonicParsing="false" onMouseClicked="#onBackArrowClick" prefHeight="81.0" prefWidth="145.0" styleClass="arrow" />
    </children>
</AnchorPane>
