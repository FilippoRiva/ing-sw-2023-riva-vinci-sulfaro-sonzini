<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane cache="true" cacheHint="SPEED" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.myshelfie.view.graphical.controllers.pregame.LobbyController">
    <ImageView fx:id="clearBackground" pickOnBounds="true">
        <Image url="@../images/lightWood.jpg"/>
    </ImageView>
    <HBox alignment="CENTER" StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="40.0">
            <padding>
                <Insets right="20.0"/>
            </padding>
            <StackPane>
                <padding>
                    <Insets left="20.0" right="20.0"/>
                </padding>
                <ImageView fx:id="scrollImage" cache="true" pickOnBounds="true">
                    <Image url="@../images/darkWood.jpg"/>
                </ImageView>
                <VBox alignment="TOP_CENTER" cache="true" prefHeight="200.0" prefWidth="100.0">
                    <HBox alignment="CENTER" cache="true">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <Label fx:id="lobbyNameLabel" alignment="CENTER" contentDisplay="CENTER"
                               minWidth="300.0" style="-fx-font-size: 35;" text="Lobby name"
                               textFill="#f2ebeb"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="minusButton" alignment="CENTER" cache="true"
                                cacheHint="SCALE_AND_ROTATE" disable="true" maxHeight="44.0" maxWidth="44.0"
                                minHeight="44.0" minWidth="44.0" onMouseClicked="#onMouseMinusClicked"
                                prefHeight="44.0" prefWidth="44.0" stylesheets="@../css/style.css" text="-"
                                textAlignment="CENTER" textFill="WHITE"/>
                        <Label fx:id="playersInLabel" alignment="CENTER" cache="true"
                               cacheHint="SCALE_AND_ROTATE" contentDisplay="CENTER"
                               style="-fx-font-size: 35;" text="1/4" textAlignment="CENTER" textFill="WHITE">
                            <padding>
                                <Insets left="10.0" right="10.0"/>
                            </padding>
                        </Label>
                        <Button fx:id="plusButton" alignment="CENTER" cache="true"
                                cacheHint="SCALE_AND_ROTATE" disable="true" maxHeight="44.0" maxWidth="44.0"
                                minHeight="44.0" minWidth="44.0" onMouseClicked="#onMousePlusClicked"
                                prefHeight="44.0" prefWidth="44.0" stylesheets="@../css/style.css" text="+"
                                textAlignment="CENTER" textFill="WHITE"/>
                    </HBox>
                    <VBox fx:id="playersVBox" alignment="CENTER" VBox.vgrow="ALWAYS">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0"/>
                        </padding>
                    </VBox>
                </VBox>
            </StackPane>
            <Button fx:id="startButton" cache="true" cacheHint="SCALE_AND_ROTATE" disable="true"
                    mnemonicParsing="false" onMouseClicked="#onStartMouseClicked" prefHeight="90.0"
                    prefWidth="300.0" styleClass="myButton" text="Start">
                <VBox.margin>
                    <Insets bottom="5.0"/>
                </VBox.margin>
            </Button>
        </VBox>
    </HBox>
    <fx:include fx:id="chat" source="chat-view.fxml" StackPane.alignment="BOTTOM_RIGHT"/>
</StackPane>
