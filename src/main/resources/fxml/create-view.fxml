<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane cache="true" cacheHint="SPEED" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/19"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.myshelfie.view.graphical.controllers.pregame.CreateController">
    <ImageView fx:id="backgroundClear" pickOnBounds="true">
        <Image url="@../images/lightWood.jpg"/>
    </ImageView>
    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" spacing="30.0">
        <padding>
            <Insets left="20.0" right="20.0"/>
        </padding>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <Label cache="true" prefHeight="90.0" prefWidth="400.0" text="Room name" textFill="#302f2f"/>
            <TextField fx:id="lobbyNameField" cache="true" cacheHint="SCALE" prefHeight="90.0" prefWidth="600.0"
                       promptText="Room name"/>
        </HBox>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <Label cache="true" prefHeight="90.0" prefWidth="400.0" text="Player name" textFill="#302f2f"/>
            <TextField fx:id="playerNameField" cache="true" cacheHint="SCALE" prefHeight="90.0" prefWidth="600.0"
                       promptText="Player name"/>
        </HBox>
        <HBox alignment="CENTER" cache="true" prefHeight="100.0" prefWidth="200.0" spacing="30.0">
            <VBox.margin>
                <Insets top="30.0"/>
            </VBox.margin>
            <Label fx:id="createErrorLabel" cache="true" cacheHint="SPEED" prefHeight="90.0" prefWidth="300.0"
                   styleClass="error" text="error" textFill="RED" visible="false"/>
            <Button fx:id="createButton" cache="true" cacheHint="SCALE" maxHeight="70.0" maxWidth="300.0"
                    minHeight="90.0" minWidth="300.0" mnemonicParsing="false"
                    onMousePressed="#onCreateMouseClicked" prefHeight="70.0" prefWidth="300.0"
                    styleClass="myButton" text="Create">
            </Button>
        </HBox>
    </VBox>
</StackPane>
