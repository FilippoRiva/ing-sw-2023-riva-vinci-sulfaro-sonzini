<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.myshelfie.view.graphical.PreGameController">
    <children>
        <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <Image url="@../images/misc/home.png" />
        </ImageView>
      <TextField fx:id="roomName" layoutX="564.0" layoutY="348.0" prefHeight="100.0" prefWidth="600.0" promptText="Room name" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="320.0">
         <font>
            <Font size="40.0" />
         </font>
      </TextField>
      <Label layoutX="42.0" layoutY="354.0" prefHeight="100.0" prefWidth="400.0" text="Room name" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="320.0">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
      <TextField fx:id="playerName" layoutX="572.0" layoutY="455.0" prefHeight="100.0" prefWidth="600.0" promptText="Player name" AnchorPane.rightAnchor="150.0" AnchorPane.topAnchor="460.0">
         <font>
            <Font size="40.0" />
         </font>
      </TextField>
      <Label layoutX="50.0" layoutY="461.0" prefHeight="100.0" prefWidth="400.0" text="Player name" AnchorPane.leftAnchor="50.0" AnchorPane.topAnchor="460.0">
         <font>
            <Font size="40.0" />
         </font>
      </Label>
      <AnchorPane onMouseClicked="#onCreateMouseClicked" onMouseEntered="#onCreateMouseEntered" onMouseExited="#onCreateMouseExited" prefHeight="80.0" prefWidth="350.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="270.0">
         <children>
            <ImageView fitHeight="80.0" fitWidth="350.0" pickOnBounds="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
               <image>
                  <Image url="@../images/misc/base_pagina2.jpg" />
               </image>
            </ImageView>
            <Label fx:id="createLabel" alignment="CENTER" prefHeight="80.0" prefWidth="350.0" text="Create" textAlignment="CENTER" textFill="WHITE" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
               <font>
                  <Font size="40.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
    </children>
</AnchorPane>
